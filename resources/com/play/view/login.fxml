<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.play.controller.LoginController">
    <!-- Header: titolo centrato in alto -->
    <top>
        <VBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
            <Label text="Login" style="-fx-font-size: 30px; -fx-font-weight: bold;" alignment="CENTER"/>
        </VBox>
    </top>
    
    <!-- Body: contenuto centrato -->
    <center>
        <VBox alignment="CENTER" spacing="20" maxWidth="400">
            <!-- GridPane per campi e label -->
            <GridPane hgap="10" vgap="10" alignment="CENTER">
                <columnConstraints>
                    <!-- Aumenta la larghezza della prima colonna a 150 per non tagliare il testo -->
                    <ColumnConstraints halignment="RIGHT" prefWidth="150"/>
                    <!-- Seconda colonna: campi con larghezza fissa -->
                    <ColumnConstraints halignment="LEFT" prefWidth="300"/>
                </columnConstraints>
                <Label text="Username:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-size: 18px;"/>
                <TextField fx:id="usernameField" promptText="Inserisci username" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Password:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-size: 18px;"/>
                <PasswordField fx:id="passwordField" promptText="Inserisci password" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>
            <!-- Spacer fra i campi e i pulsanti -->
            <Region prefHeight="20"/>
            <!-- Sezione dei pulsanti -->
            <HBox spacing="20" alignment="CENTER">
                <Button text="Registrati" onAction="#handleCreateUser" prefWidth="150"
                        style="-fx-background-color: #4F81BD;"/>
                <Button text="Accedi" onAction="#handleLogin" prefWidth="150"
                        style="-fx-background-color: #F1982E;"/>
            </HBox>
        </VBox>
    </center>
    
    <!-- Padding globale -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
</BorderPane>
