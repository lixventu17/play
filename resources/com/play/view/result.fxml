<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8" fx:controller="com.play.controller.ResultController">
    <Text fx:id="resultText" style="-fx-font-size: 24px;"/>
    <Button fx:id="nextLevelButton" text="Next Level" onAction="#handleNextLevel"/>
    <Button fx:id="homepageButton" text="Homepage" onAction="#handleHomepage"/>
</VBox>
