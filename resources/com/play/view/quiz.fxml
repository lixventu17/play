<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.play.controller.QuizController">
    <!-- Top: Data/Ora di inizio a sinistra, Timer a destra -->
    <top>
        <HBox alignment="CENTER" spacing="20" BorderPane.alignment="CENTER">
            <Label fx:id="startDateLabel" style="-fx-font-size: 16px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="timerLabel" text="Tempo: 00:00" style="-fx-font-size: 16px;"/>
        </HBox>
    </top>
    
    <!-- Center: Domanda e opzioni -->
    <center>
        <VBox alignment="CENTER" spacing="20" maxWidth="800">
            <Label fx:id="question" wrapText="true" style="-fx-font-size: 20px; -fx-font-weight: bold;" maxWidth="800"/>
            <Label fx:id="text" wrapText="true" style="-fx-font-size: 18px;" maxWidth="800"/>
            <Region prefHeight="50"/>
            <!-- Container per le opzioni: imposto una larghezza massima fissa per forzare l'allineamento -->
            <VBox alignment="CENTER" spacing="20">
                <!-- In alternativa, puoi fissare la larghezza dei RadioButton per uniformare l'allineamento -->
                <RadioButton fx:id="option1" toggleGroup="$toggleGroup" style="-fx-font-size: 18px;" maxWidth="800"/>
                <RadioButton fx:id="option2" toggleGroup="$toggleGroup" style="-fx-font-size: 18px;" maxWidth="800"/>
                <RadioButton fx:id="option3" toggleGroup="$toggleGroup" style="-fx-font-size: 18px;" maxWidth="800"/>
                <RadioButton fx:id="option4" toggleGroup="$toggleGroup" style="-fx-font-size: 18px;" maxWidth="800"/>
            </VBox>
            <Region prefHeight="50"/>
            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="previousButton" text="Precedente" onAction="#handlePrevious" prefWidth="150"
                		style="-fx-background-color: #FAB228;"/>
                <Button fx:id="nextButton" text="Seguente" onAction="#handleSubmit" prefWidth="150"
                		style="-fx-background-color: #7DC243;"/>
            </HBox>
        </VBox>
    </center>
    
    <!-- Bottom: Punteggio e pulsante Abbandona -->
    <bottom>
        <VBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
            <Label fx:id="scoreLabel" text="Punteggio: 0" style="-fx-font-size: 16px;"/>
            <Button fx:id="finishButton" text="Abbandona" onAction="#handleBackToHomepage" prefWidth="150"
                    style="-fx-background-color: #E53935;"/>
        </VBox>
    </bottom>
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
</BorderPane>
