<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.play.controller.HomeController">
    <!-- Header: saluto in alto -->
    <top>
        <VBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
            <Label fx:id="greetingLabel" text="Ciao [Nome]!" style="-fx-font-size: 30px; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    
    <!-- Centro: cubotti per gli esercizi -->
    <center>
        <HBox alignment="CENTER" spacing="50">
            <!-- Cubotto per "Conoscenza e Lettura del codice" -->
            <VBox alignment="CENTER" spacing="10">
                <ImageView fx:id="exerciseImage1" onMouseClicked="#handleExercise1Click" fitWidth="300" fitHeight="300" preserveRatio="true">
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ImageView>
                <Label fx:id="exerciseTitle1" text="Esercizio 1" style="-fx-font-size: 18px;"/>
                <ProgressBar fx:id="progressBarExercise1" prefWidth="200"/>
                <ImageView fx:id="imageMedal1" preserveRatio="true"/>
            </VBox>
            <!-- Cubotto per "Conoscenza e Scrittura del codice" -->
            <VBox alignment="CENTER" spacing="10">
                <ImageView fx:id="exerciseImage2" onMouseClicked="#handleExercise2Click" fitWidth="300" fitHeight="300" preserveRatio="true">
                    <cursor>
                        <Cursor fx:constant="HAND"/>
                    </cursor>
                </ImageView>
                <Label fx:id="exerciseTitle2" text="Esercizio 2" style="-fx-font-size: 18px;"/>
                <ProgressBar fx:id="progressBarExercise2" prefWidth="200"/>
                <ImageView fx:id="imageMedal2" preserveRatio="true"/>
            </VBox>
        </HBox>
    </center>
    
    <!-- Footer: pulsanti Profilo e Logout -->
    <bottom>
        <HBox spacing="20" alignment="CENTER" BorderPane.alignment="CENTER">
            <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout" prefWidth="150"
                    style="-fx-background-color: #E53935;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="profileButton" text="Profilo" onAction="#handleProfile" prefWidth="150"
                    style="-fx-background-color: #039BE5;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="leaderboardButton" text="Classifica" onAction="#handleLeaderboard" prefWidth="150"
                    style="-fx-background-color: #5232ED;"/>
        </HBox>
    </bottom>
    
    <!-- Padding globale -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
</BorderPane>
