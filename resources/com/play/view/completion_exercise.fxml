<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.play.controller.CompletionExerciseController">
    <Label fx:id="questionText"/>
    <TextField fx:id="answerField"/>
    <Button text="Domanda Precedente" onAction="#handlePrevious"/>
    <Button text="Prossima Domanda" onAction="#handleSubmit"/>
    <Button text="Esci" fx:id="finishButton" onAction="#handleBackToHomepage"/>
    <Label fx:id="scoreLabel" text="Punteggio: 0"/>
    <Label fx:id="timerLabel" text="Tempo: 00:00"/>
</VBox>
